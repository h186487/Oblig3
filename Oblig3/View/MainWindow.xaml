<Window x:Class="Oblig3.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Oblig3.View"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Search-->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Search Student" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                <DockPanel>
                    <Button Content="Search" DockPanel.Dock="Right" Click="SearchStudent_Click" Padding="6,5" Margin="6,0,0,5"/>
                    <TextBox x:Name="SearchBox" Padding="6.5" Margin="6,0,0,5"/>
                </DockPanel>
            </StackPanel>

            <!--Course Dropdown-->
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Filter by Course" FontSize="12" Foreground="Gray" Margin="0,0,0,7"/>
                <ComboBox x:Name="CourseDropdown" DisplayMemberPath="Coursename" Padding="6,5"/>
            </StackPanel>

            <!--Grade Dropdown-->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Filter by Grade" FontSize="12" Foreground="Gray" Margin="0,0,0,7"/>
                <ComboBox x:Name="GradeDropdown" Padding="6,5"/>
            </StackPanel>
        </Grid>

        <!-- ROW 2: Action buttons -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" >
            <Button Content="Show course students" Click="ShowCourseStudents_Click" 
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Show grades &gt;= selected" Click="ShowGrades_Click" 
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Show failed students" Click="ShowFailed_Click" 
                    Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Manage enrollments" Click="ShowManageEnrollments_Click" 
                    Padding="12,6"/>
        </WrapPanel>

        <!-- ROW 3: Current view label -->
        <TextBlock x:Name="CurrentViewLabel" Grid.Row="2" 
                   FontSize="11" Foreground="Gray" Margin="0,0,0,6"
                   Text="Showing: all students"/>

        <!-- ROW 4: Main results grid -->
        <DataGrid x:Name="MainGrid" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  BorderThickness="0.5" BorderBrush="LightGray"
                  RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="WhiteSmoke">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student name" 
                                    Binding="{Binding StudentName}" Width="*"/>
                <DataGridTextColumn Header="Course" 
                                    Binding="{Binding CourseName}" Width="*"/>
                <DataGridTextColumn Header="Grade" 
                                    Binding="{Binding Grade}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="EnrollPanel" Grid.Row="4" BorderBrush="LightGray" BorderThickness="0.5"
                CornerRadius="6" Padding="12" Margin="0,12,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Manage Enrollments" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <WrapPanel Grid.Row="1">
                    <ComboBox x:Name="EnrollCourseComboBox" DisplayMemberPath="Coursename" Width="200" Margin="0,0,8,0"/>
                    <ComboBox x:Name="AddStudentBox" DisplayMemberPath="StudentName" Width="200" Margin="0,0,8,0"/>
                    <ComboBox x:Name="AddGradeBox" Width="200" Margin="0,0,8,0"/>
                    <Button Content="Add student" Click="AddEnrollment_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Remove student" Click="RemoveEnrollment_Click" Padding="12,6"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

